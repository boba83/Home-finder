# ------------------------------------------------------------
# Home Finder - konfiguracija servera
# Kopirajte ovaj fajl u `server/.env` i popunite vrednosti.
# ------------------------------------------------------------

# Port na kome radi API (frontend u dev modu šalje zahteve preko Vite proxy-ja)
PORT=4817

# SQLite baza (putanja je relativna u odnosu na server/prisma/)
DATABASE_URL="file:./dev.db"

# Dozvoljeni origin za CORS (Vite dev server)
CLIENT_ORIGIN=http://localhost:5817

# Web Push (VAPID) ključevi - generišite ih komandom: npm run vapid
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt koji se šalje push servisima (mailto: ili https: URL)
VAPID_SUBJECT=mailto:vas-email@example.com

# Scraper - pauze između zahteva ka ISTOM sajtu (milisekunde).
# Svaki zahtev čeka nasumično vreme između MIN i MAX.
SCRAPER_MIN_DELAY_MS=4000
SCRAPER_MAX_DELAY_MS=9000
# Maksimalno pokušaja po zahtevu (sa eksponencijalnim čekanjem kod 429/5xx)
SCRAPER_MAX_RETRIES=3
# Timeout po zahtevu
SCRAPER_TIMEOUT_MS=30000

# Da li da se skeniranje pokrene odmah po startu servera (true/false)
SCRAPE_ON_START=true
